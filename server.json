{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.songofhawk/doco",
  "title": "Doco",
  "description": "Doco knowledge workspace with block-safe editing, search, and 29 tools for humans and AI agents.",
  "version": "0.1.4",
  "websiteUrl": "https://doco.page",
  "repository": {
    "url": "https://github.com/songofhawk/doco",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://doco.page/doco.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "doco-agent-cli",
      "version": "0.1.4",
      "runtimeHint": "npx",
      "runtimeArguments": [
        { "type": "positional", "value": "-y" },
        { "type": "positional", "value": "--package" },
        { "type": "positional", "value": "doco-agent-cli" }
      ],
      "packageArguments": [
        { "type": "positional", "value": "doco" },
        { "type": "positional", "value": "mcp" }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.doco.page/mcp"
    }
  ]
}
